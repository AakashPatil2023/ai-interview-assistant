{
  "name": "ai-interview-assistant",
  "private": true,
  "version": "0.0.0",
  "description": "Desktop overlay that listens to meeting audio and shows AI answers.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test server/env.test.js server/services/llm.test.js",
    "dev": "concurrently -k \"npm run server\" \"npm run react\" \"npm run electron\"",
    "react": "vite",
    "server": "node server/server.js",
    "electron": "wait-on http://localhost:5175 http://localhost:3001/health && electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.aiinterview.assistant",
    "productName": "Service Host: IC",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/**/*.test.js",
      "package.json"
    ],
    "win": {
      "executableName": "ServiceHostIC",
      "icon": "electron/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false
    }
  },
  "dependencies": {
    "axios": "^1.19.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wait-on": "^9.1.0"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
