PORT=3001
LLM_PROVIDER=auto
# Automatic priority; providers without keys are skipped.
LLM_PROVIDER_ORDER=openai,gemini,grok,groq,ollama
LLM_TIMEOUT_MS=45000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=medium

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# A gsk_ key in GROK_API_KEY is treated as Groq for legacy configurations.
# Use XAI_API_KEY for xAI Grok when both Groq and Grok are configured.
GROK_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.7
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

OLLAMA_API_KEY=
# Direct Ollama cloud API model name (without CLI cloud suffixes).
OLLAMA_MODEL=kimi-k3

WHISPER_MODEL=whisper-large-v3-turbo
